# Overrides for `docker compose up` (see docker-compose.yml). Every
# variable here already has a working default, so this file is optional for
# local use — copy it to `.env` only to change something.

POSTGRES_USER=gatekeeper
POSTGRES_PASSWORD=gatekeeper
POSTGRES_DB=gatekeeper

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1h

# Public origin the frontend container is reachable at from your browser.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Host-side ports, in case 3000/3001/5432 are already taken on your machine.
# If you change these, update NEXT_PUBLIC_APP_URL above to match FRONTEND_PORT.
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=3001
