PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# PostgreSQL connection string
# Local:  postgresql://gatekeeper:gatekeeper@localhost:5432/gatekeeper?schema=public
# Neon:   postgresql://USER:PASSWORD@HOST.neon.tech/gatekeeper?sslmode=require
DATABASE_URL=postgresql://gatekeeper:gatekeeper@localhost:5432/gatekeeper?schema=public

# Origins allowed to open a WebSocket (comma-separated). Unset = any origin.
# e.g. FRONTEND_ORIGIN=https://gate-keeper-three.vercel.app
FRONTEND_ORIGIN=http://localhost:3001
